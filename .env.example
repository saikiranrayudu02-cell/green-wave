[TEMPLATE]
# ============================================================================
# GREENWAVE — environment (Steps 6 + 7)
# Copy to `.env` and fill in real values when a cloud backend is available.
# NEVER commit a `.env` containing real credentials.
# ============================================================================

# Demo mode (default). Keep true for an offline, fully self-contained demo.
# When Supabase credentials are present, set this to false to require a real
# municipal sign-in; leave true to keep demo access alongside the cloud sync.
VITE_DEMO_MODE=true

# --- Supabase (persistent system of record + auth + realtime) ---------------
# Both must be set for the Supabase repository to activate. The anon key is a
# publishable client credential — never use the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Convex (live operational state — see BACKEND.md / convex/README.md) ----
# The deployment URL drives the HTTP-mutation bridge. WebSocket subscriptions
# are a bonus (optional realtime).
VITE_CONVEX_URL=

# --- Bootstrap key for Convex admin operations (CLI only, never in UI) ------
# Used by: npx convex run functions:initDeployment / addOperator
CONVEX_BOOTSTRAP_KEY=

# --- Organization label shown in the UI -------------------------------------
VITE_ORG_NAME=Boston Traffic Operations (DEMO)
